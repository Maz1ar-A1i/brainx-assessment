APP_NAME=CaptchaLab AI
APP_ENV=development
DATABASE_PATH=./captchalab.db
ARTIFACT_DIR=./artifacts
MAX_UPLOAD_BYTES=2097152
MAX_CSV_BYTES=5242880

# Official provider server-verification timeouts.
PROVIDER_TIMEOUT_SECONDS=12
PROVIDER_WIDGET_TIMEOUT_SECONDS=25
PROVIDER_INTERACTION_TIMEOUT_SECONDS=90
PROVIDER_VERIFICATION_TIMEOUT_SECONDS=18

# Playwright settings.
BROWSER_TIMEOUT_MS=20000
CHROMIUM_EXECUTABLE=
# Keep false for the provider E2E test: reCAPTCHA v2 may need a visible click.
PROVIDER_TEST_HEADLESS=false
# The E2E route opens this local application URL in its Playwright browser.
APP_BASE_URL=http://127.0.0.1:8000

# Security: list only localhost or hostnames you own / have explicit permission to test.
# Do not use * or a wildcard to scan arbitrary CSV websites.
ALLOWED_TARGET_HOSTS=localhost,127.0.0.1,::1,captchalab.test

# Provider CDN hosts needed by the locally hosted official test widgets.
ALLOWED_RESOURCE_HOSTS=www.google.com,google.com,www.gstatic.com,recaptcha.net,www.recaptcha.net,js.hcaptcha.com,hcaptcha.com,newassets.hcaptcha.com,challenges.cloudflare.com,cloudflare.com

# Official provider test credentials. Use only in local test environments.
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional Gemini fallback for the synthetic text family. Keep the key local only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=12
GEMINI_FALLBACK_THRESHOLD=0.50
# free = $0 within the available free tier; paid = estimate from usageMetadata.
# Gemini 3.8 Flash standard rates below are valid through 2026-12-31; update after that.
GEMINI_BILLING_TIER=free
GEMINI_INPUT_USD_PER_MILLION=0.75
GEMINI_OUTPUT_USD_PER_MILLION=3.75
